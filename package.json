{
  "name": "@pixi/lights",
  "version": "8.x-1.0.0",
  "description": "A plugin that adds deferred rendering to PixiJS v8",
  "author": "Ivan Popelyshev, Mark Wallace",
  "contributors": [
    "Ivan Popelyshev <ivan.popelyshev@gmail.com>",
    "Matt Karl <matt@mattkarl.com>",
    "Mark Wallace <roadwallace@gmail.com>"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixijs-userland/lights"
  },
  "scripts": {
    "clean": "rm -rf lib dist .pr_uploads .s3_uploads",
    "build": "npm run clean && rollup -c .configs/rollup.config.mjs",
    "watch": "rollup -c .configs/rollup.config.mjs -w"
  },
  "files": [
    "dist/",
    "lib/"
  ],
  "peerDependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "pixi.js": "^8.22.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.55.1",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3"
  }
}
